# Template for .env (copy it to .env, which is git-ignored, and edit the values).
# Time zone for the server (overrides the host's /etc/localtime).
TZ=America/Denver

# Keycloak (realm mlw). The dev container reaches it over the mlw-platform_default
# docker network (see compose.override.yaml), not via the host's localhost:8180.
MLW_KEYCLOAK_URL=http://mlw-keycloak:8080
MLW_KEYCLOAK_REALM=mlw
MLW_KEYCLOAK_CLIENT_ID=mlw-xsheet

# Lets a user whom Keycloak requires to change their password do so at login. Run
# tools/keycloak_setup.py, which prints the secret of its mlw-xsheet-admin client.
MLW_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Per-user settings and unsaved drafts are kept in Redis (the redis service in compose.yaml).
# MLW_REDIS_URL empty turns it off (settings then stay per browser). Optionally require a password:
#MLW_REDIS_URL=redis://redis:6379/0
#MLW_REDIS_PASSWORD=

# Template for .env (copy it to .env, which is git-ignored, and edit the values).
# Time zone for the server (overrides the host's /etc/localtime).
TZ=America/Denver

# Keycloak (realm mlw). The dev container reaches it over the mlw-platform_default
# docker network (see compose.override.yaml), not via the host's localhost:8180.
MLW_KEYCLOAK_URL=http://mlw-keycloak:8080
MLW_KEYCLOAK_REALM=mlw
MLW_KEYCLOAK_CLIENT_ID=mlw-xsheet

# Lets a user whom Keycloak requires to change their password do so at login. Run
# tools/keycloak_setup.py, which prints the secret of its mlw-xsheet-admin client.
MLW_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Per-user settings and unsaved drafts are kept in Valkey (the valkey service in compose.yaml).
# MLW_VALKEY_URL empty turns it off (settings then stay per browser). Optionally require a password:
#MLW_VALKEY_URL=valkey://valkey:6379/0
#MLW_VALKEY_PASSWORD=

# The user's own file storage: an mlw-storage server (SFTPGo behind its gateway; see its User Guide).
# Users need the Keycloak role mlw-user. The dev container reaches the gateway over the
# mlw-platform_default network (see compose.override.yaml). Empty MLW_STORAGE_URL turns it off.
#MLW_STORAGE_URL=http://mlw-proxy:8000
#MLW_STORAGE_SFTP_HOST=mlw-proxy
#MLW_STORAGE_SFTP_PORT=2222
#MLW_STORAGE_NAME=mlw-storage
#MLW_STORAGE_READONLY_ROLE=
#MLW_STORAGE_HOST_KEY=

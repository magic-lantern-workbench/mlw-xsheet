<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="urn:xsheet:camera:2.0"
    xmlns="urn:xsheet:camera:2.0"
    elementFormDefault="qualified">

    <!-- ===================================== -->
    <!-- Root Camera Definition                -->
    <!-- ===================================== -->

    <xs:element name="Camera">
        <xs:complexType>
            <xs:sequence>

                <!-- Optional human-readable move -->
                <xs:element name="CameraMove"
                            type="CameraMoveType"
                            minOccurs="0"
                            maxOccurs="unbounded"/>

                <!-- Machine-readable animation -->
                <xs:element name="Keyframe"
                            type="CameraKeyframeType"
                            minOccurs="1"
                            maxOccurs="unbounded"/>

            </xs:sequence>

            <xs:attribute name="cameraId"
                          type="xs:string"
                          use="required"/>

            <xs:attribute name="name"
                          type="xs:string"/>

            <xs:attribute name="projection"
                          type="ProjectionType"
                          default="Orthographic"/>
        </xs:complexType>
    </xs:element>

    <!-- ===================================== -->
    <!-- Human-readable camera moves           -->
    <!-- ===================================== -->

    <xs:complexType name="CameraMoveType">
        <xs:sequence>
            <xs:element name="Description"
                        type="xs:string"
                        minOccurs="0"/>
        </xs:sequence>

        <xs:attribute name="type"
                      type="CameraMoveEnum"
                      use="required"/>

        <xs:attribute name="startFrame"
                      type="xs:positiveInteger"
                      use="required"/>

        <xs:attribute name="endFrame"
                      type="xs:positiveInteger"
                      use="required"/>
    </xs:complexType>

    <!-- ===================================== -->
    <!-- Camera Keyframes                      -->
    <!-- ===================================== -->

    <xs:complexType name="CameraKeyframeType">

        <xs:attribute name="frame"
                      type="xs:positiveInteger"
                      use="required"/>

        <!-- Position -->
        <xs:attribute name="x"
                      type="xs:decimal"
                      default="0"/>

        <xs:attribute name="y"
                      type="xs:decimal"
                      default="0"/>

        <xs:attribute name="z"
                      type="xs:decimal"
                      default="0"/>

        <!-- Rotation -->
        <xs:attribute name="rotationX"
                      type="xs:decimal"
                      default="0"/>

        <xs:attribute name="rotationY"
                      type="xs:decimal"
                      default="0"/>

        <xs:attribute name="rotationZ"
                      type="xs:decimal"
                      default="0"/>

        <!-- Viewing -->
        <xs:attribute name="zoom"
                      type="xs:decimal"
                      default="1.0"/>

        <xs:attribute name="focalLength"
                      type="xs:decimal"
                      default="35"/>

        <!-- Curve -->
        <xs:attribute name="interpolation"
                      type="InterpolationType"
                      default="Bezier"/>

        <!-- Optional cue -->
        <xs:attribute name="note"
                      type="xs:string"/>
    </xs:complexType>

    <!-- ===================================== -->
    <!-- Enumerations                          -->
    <!-- ===================================== -->

    <xs:simpleType name="CameraMoveEnum">
        <xs:restriction base="xs:string">

            <xs:enumeration value="HOLD"/>
            <xs:enumeration value="PAN_LEFT"/>
            <xs:enumeration value="PAN_RIGHT"/>

            <xs:enumeration value="PAN_UP"/>
            <xs:enumeration value="PAN_DOWN"/>

            <xs:enumeration value="TRUCK_LEFT"/>
            <xs:enumeration value="TRUCK_RIGHT"/>

            <xs:enumeration value="TRUCK_FORWARD"/>
            <xs:enumeration value="TRUCK_BACK"/>

            <xs:enumeration value="ZOOM_IN"/>
            <xs:enumeration value="ZOOM_OUT"/>

            <xs:enumeration value="TILT_UP"/>
            <xs:enumeration value="TILT_DOWN"/>

            <xs:enumeration value="ROLL"/>

            <xs:enumeration value="CUSTOM"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InterpolationType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Step"/>
            <xs:enumeration value="Linear"/>
            <xs:enumeration value="Bezier"/>
            <xs:enumeration value="Spline"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ProjectionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Orthographic"/>
            <xs:enumeration value="Perspective"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>

<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 targetNamespace="http://schemas.animation.org/xsheet/audio"
 xmlns="http://schemas.animation.org/xsheet/audio"
 elementFormDefault="qualified">

 <xs:element name="AudioTracks">
     <xs:complexType>
         <xs:sequence>
             <xs:element name="Track"
                         type="TrackType"
                         maxOccurs="unbounded"/>
         </xs:sequence>
     </xs:complexType>
 </xs:element>

 <xs:complexType name="TrackType">
     <xs:attribute name="id" type="xs:ID" use="required"/>
     <xs:attribute name="type" type="TrackTypeEnum" use="required"/>
     <xs:attribute name="file" type="xs:string" use="required"/>
 </xs:complexType>

 <xs:simpleType name="TrackTypeEnum">
     <xs:restriction base="xs:string">
         <xs:enumeration value="Dialogue"/>
         <xs:enumeration value="Music"/>
         <xs:enumeration value="Effects"/>
     </xs:restriction>
 </xs:simpleType>

</xs:schema>

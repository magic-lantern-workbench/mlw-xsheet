<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
 xmlns:xs="http://www.w3.org/2001/XMLSchema"
 targetNamespace="http://schemas.animation.org/xsheet/audio"
 xmlns="http://schemas.animation.org/xsheet/audio"
 elementFormDefault="qualified">

 <xs:element name="AudioTracks">
     <xs:complexType>
         <xs:sequence>
             <xs:element name="Track"
                         type="TrackType"
                         maxOccurs="unbounded"/>
         </xs:sequence>
     </xs:complexType>
 </xs:element>

 <xs:complexType name="TrackType">
     <xs:sequence>
         <xs:element name="sourceURL" type="xs:anyURI" minOccurs="0"/>
         <xs:element name="author" type="xs:string" minOccurs="0"/>
         <xs:element name="contact" type="EmailAddressType" minOccurs="0" maxOccurs="unbounded"/>
     </xs:sequence>

     <xs:attribute name="id" type="xs:ID" use="required"/>
     <xs:attribute name="type" type="TrackTypeEnum" use="required"/>
     <xs:attribute name="file" type="xs:string" use="required"/>
     <xs:attribute name="description" type="xs:string"/>
 </xs:complexType>

 <xs:simpleType name="TrackTypeEnum">
     <xs:restriction base="xs:string">
         <xs:enumeration value="Dialogue"/>
         <xs:enumeration value="Music"/>
         <xs:enumeration value="Effects"/>
     </xs:restriction>
 </xs:simpleType>

 <xs:simpleType name="EmailAddressType">
     <!-- xs:token removes leading/trailing whitespaces automatically -->
     <xs:restriction base="xs:token"> 
         <xs:maxLength value="254"/>
         <!-- Standard email validation pattern -->
         <xs:pattern value="[^@]+@[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}"/>
     </xs:restriction>
 </xs:simpleType>

</xs:schema>
